{
  "name": "contentmap-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for contentmap — the type-safe, framework-agnostic content layer.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sa7vik/contentmap.git"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm -r --parallel --filter './packages/*' run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:publish": "pnpm -r --filter './packages/*' exec publint && pnpm -r --filter './packages/*' exec attw --pack .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {},
  "keywords": [
    "content",
    "contentlayer",
    "velite",
    "content-collections",
    "markdown",
    "mdx",
    "zod",
    "typescript"
  ]
}
