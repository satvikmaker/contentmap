{
  "name": "contentmap-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for contentmap — the type-safe, framework-agnostic content layer.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.11.0 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sa7vik/contentmap.git"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm -r --parallel --filter './packages/*' run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "format": "prettier --write .",
    "check:publish": "pnpm -r --filter './packages/*' exec publint && pnpm -r --filter './packages/*' exec attw --pack . --profile esm-only",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "bench": "node scripts/bench.mjs 10000",
    "bench:bundle": "node scripts/bundle-size.mjs",
    "gate:fd": "./scripts/fd-limit-gate.sh",
    "verify:vite": "node --experimental-strip-types scripts/verify-vite.mjs",
    "verify:types": "node scripts/verify-types.mjs",
    "verify:examples": "pnpm -r --workspace-concurrency=1 --filter './examples/*' run build",
    "bench:compare": "node scripts/bench-compare.mjs 1000",
    "verify:footprint": "node scripts/footprint.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.20.1",
    "arktype": "^2.2.3",
    "effect": "^3.22.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "rolldown": "^1.2.4",
    "tsdown": "~0.22.14",
    "typescript": "^5.9.3",
    "valibot": "^1.4.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "keywords": [
    "content",
    "contentlayer",
    "velite",
    "content-collections",
    "markdown",
    "mdx",
    "zod",
    "typescript"
  ]
}
