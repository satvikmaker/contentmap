+import { blogs, authors } from 'contentmap/generated'
+
+export type { Blog, Authors } from 'contentmap/generated'
+export { blogs, authors }
+
+/**
+ * Every document, without its body.
+ *
+ * contentmap emits a module per document plus an index; `all()` reads the
+ * index, so listing pages never load a single body. The post page loads the
+ * one body it renders with `blogs.load(id)`.
+ */
+export const allBlogs = blogs.all()
+export const allAuthors = authors.all()
+
+/**
+ * What pliny's helpers did, for documents shaped by contentmap.
+ *
+ * pliny dropped `body`, `_raw` and `_id` — the body and contentlayer's
+ * provenance. contentmap keeps provenance on `_meta`, so that goes too;
+ * otherwise every entry of a search index carries it.
+ */
+export type CoreContent<T> = Omit<T, 'body' | '_meta'>
+
+export const coreContent = <T extends object>(doc: T): CoreContent<T> => {
+  const {
+    body: _body,
+    _meta: _provenance,
+    ...rest
+  } = doc as T & { body?: unknown; _meta?: unknown }
+  return rest as CoreContent<T>
+}
+
+export const allCoreContent = <T extends object>(docs: T[]): CoreContent<T>[] =>
+  docs.map(coreContent)
+
+export const sortPosts = <T extends { date: string }>(posts: T[]): T[] =>
+  [...posts].sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0))
