    },
    "@orama/plugin-data-persistence": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orama/orama": "^3.1.13",
    "@orama/plugin-data-persistence": "^3.1.13",
    "minisearch": "^7.2.0",
    "pagefind": "^1.4.0"
