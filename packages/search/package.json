{
  "name": "@contentmap/search",
  "version": "1.2.0",
  "description": "Search index hooks for contentmap — Pagefind, Orama and MiniSearch, without shipping the corpus.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satvikmaker/contentmap.git",
    "directory": "packages/search"
  },
  "bugs": "https://github.com/satvikmaker/contentmap/issues",
  "homepage": "https://github.com/satvikmaker/contentmap#readme",
  "engines": {
    "node": "^22.11.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
