{
  "name": "contentmap",
  "version": "0.1.0",
  "description": "The type-safe content layer for every framework.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satvikmaker/contentmap.git",
    "directory": "packages/contentmap"
  },
  "bugs": "https://github.com/satvikmaker/contentmap/issues",
  "homepage": "https://github.com/satvikmaker/contentmap#readme",
  "engines": {
    "node": "^22.11.0 || >=24"
  },
  "bin": {
    "contentmap": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('node:fs').copyFileSync('../../'+f, f)\""
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "chokidar": "^5.0.0",
    "confbox": "^0.2.4",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
